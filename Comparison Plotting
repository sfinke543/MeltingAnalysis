# ----------------------------------------------------------------------
# Helper: read ALL @type xydy blocks from an .xmgr file
# ----------------------------------------------------------------------
def read_xmgr_all_xydy_blocks(filename):
    datasets = []
    xs, ys, dys = [], [], []
    in_block = False

    with open(filename, "r") as f:
        for line in f:
            s = line.strip()
            if not s:
                continue

            if s.startswith("@type") and "xydy" in s:
                if in_block and xs:
                    datasets.append(
                        (np.array(xs), np.array(ys), np.array(dys))
                    )
                xs, ys, dys = [], [], []
                in_block = True
                continue

            if s.startswith("&"):
                if in_block and xs:
                    datasets.append(
                        (np.array(xs), np.array(ys), np.array(dys))
                    )
                in_block = False
                xs, ys, dys = [], [], []
                continue

            if not in_block:
                continue

            if s[0] in "@#&":
                continue

            parts = s.split()
            if len(parts) < 3:
                continue

            try:
                x = float(parts[0])
                y = float(parts[1])
                dy = float(parts[2])
            except ValueError:
                continue

            xs.append(x)
            ys.append(y)
            dys.append(dy)

    if in_block and xs:
        datasets.append((np.array(xs), np.array(ys), np.array(dys)))

    if not datasets:
        raise RuntimeError(f"No xydy data blocks found in {filename}")

    return datasets


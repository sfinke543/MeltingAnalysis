#!/usr/bin/env bash
# Minimal: Mean HB vs Temperature with error bars (Mean ± SD), opens in xmgrace.
# List format: <traj.nc> <dt_ns>   (T is read from filename like ..._310K_...nc)

set -euo pipefail

TOP="${TOP:-/nfs/mathusalem/maxence/sfinke/Mutand/forcedbond/3FIQforced.prmtop}"
LIST="${LIST:-/nfs/mathusalem/maxence/sfinke/Skripts/TripHBavg/traj_list_temp.txt}"

reps="hb_vs_temp_reps.dat"
grouped="hb_vs_temp_grouped.dat"
> "$reps"

n=0
while IFS= read -r line; do
  [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

  traj=$(awk '{print $1}' <<<"$line")
  dt=$(awk '{print $2}' <<<"$line")

  [[ -z "${traj:-}" || -z "${dt:-}" ]] && continue
  [[ ! -s "$traj" ]] && { echo "[skip] $traj" >&2; continue; }

  # --- auto-detect T from filename, e.g., prod_310K_10ns.nc ---
  fname=$(basename "$traj")
  if [[ "$fname" =~ _([0-9]+)K(_|\.nc$) ]]; then
    T="${BASH_REMATCH[1]}"
  else
    echo "[error] Could not parse temperature from: $fname (expect *_###K_*.nc)" >&2
    continue
  fi

  n=$((n+1)); tag=$(printf "%02d" "$n")

  cat > "_hb_${tag}.in" <<EOF
parm ${TOP}
trajin ${traj}
autoimage
hbond HB series out hb_series_${tag}.dat
run
EOF
  cpptraj -i "_hb_${tag}.in" >/dev/null

  awk -v dt="$dt" 'NR==1{next}{s=0; for(i=2;i<=NF;i++) s+=$i; print ((NR-2)*dt), s}' \
    "hb_series_${tag}.dat" > "hb_count_${tag}.dat"

  mean=$(awk '{S+=$2;N++} END{if(N) printf "%.6f", S/N; else print "nan"}' "hb_count_${tag}.dat")
  printf "%s\t%s\n" "$T" "$mean" >> "$reps"
done < "$LIST"

awk '
{ t=$1; y=$2; c[t]++; s[t]+=y; q[t]+=y*y }
END{
  for(t in c){
    n=c[t]; m=s[t]/n
    v=(n>1)?(q[t]-s[t]*s[t]/n)/(n-1):0
    sd=(v>0)?sqrt(v):0
    printf "%s\t%.6f\t%.6f\n", t, m, sd
  }
}' "$reps" | sort -n > "$grouped"

xmgrace -block "$grouped" -settype xydy -bxy 1:2:3 \
  -pexec 'with g0; legend off' \
  -pexec 'with g0; xaxis label "Temperature (K)"' \
  -pexec 'with g0; yaxis label "Mean number of H-bonds"' &

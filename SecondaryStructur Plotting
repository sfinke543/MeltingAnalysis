import numpy as np
import matplotlib.pyplot as plt
from matplotlib import colors as mcolors
from pathlib import Path

# ----------------------------------------------------------------------
# 1. Your xmgr files and titles  (5 systems)
# ----------------------------------------------------------------------
xmgr_files = [
    "/nfs/mathusalem/maxence/sfinke/Skripts/TripSS/Data/ff19SBData.xmgr",
    "/nfs/mathusalem/maxence/sfinke/Skripts/TripSS/Data/ff14IDPSFFData.xmgr",
    "/nfs/mathusalem/maxence/sfinke/Skripts/TripSS/Data/LigandData.xmgr",
    "/nfs/mathusalem/maxence/sfinke/Skripts/TripSS/Data/NoCCData.xmgr",
    "/nfs/mathusalem/maxence/sfinke/Skripts/TripSS/Data/GateMutanddata.xmgr",
]

subplot_titles = [
    "ff19SB [A]",
    "ff14IDPSFF [B]",
    "Benzothiazole [C]",
    "Without SS-Bond [D]",
    "Gate Mutand [E]",
]

legend_labels = [
    "ff19SB",
    "ff14IDPSFF",
    "Benzothiazole",
    "Without SS-Bond",
    "Gate Mutand",
]

# ----------------------------------------------------------------------
# 2. Base colors per FILE, as hex (5 colors)
# ----------------------------------------------------------------------
base_colors = [
    "#f44336",  # ff19SB
    "#2196f3",  # ff14IDPSFF
    "#4caf50",  # Benzothiazole
    "#ff9800",  # Without SS-Bond
    "#9c27b0",  # Gate Mutand
]

def lighten_color(hex_color, factor=0.5):
    """
    Lighten a hex color by blending it with white.

    factor = 0 -> original color
    factor = 1 -> white
    """
    rgb = np.array(mcolors.to_rgb(hex_color))
    white = np.array([1.0, 1.0, 1.0])
    new_rgb = (1 - factor) * rgb + factor * white
    return mcolors.to_hex(new_rgb)

# ----------------------------------------------------------------------
# 3. Helper: read ALL @type xydy blocks from an .xmgr file
# ----------------------------------------------------------------------
def read_xmgr_all_xydy_blocks(filename):
    datasets = []
    xs, ys, dys = [], [], []
    in_block = False

    with open(filename, "r") as f:
        for line in f:
            s = line.strip()
            if not s:
                continue

            if s.startswith("@type") and "xydy" in s:
                if in_block and xs:
                    datasets.append(
                        (np.array(xs), np.array(ys), np.array(dys))
                    )
                xs, ys, dys = [], [], []
                in_block = True
                continue

            if s.startswith("&"):
                if in_block and xs:
                    datasets.append(
                        (np.array(xs), np.array(ys), np.array(dys))
                    )
                in_block = False
                xs, ys, dys = [], [], []
                continue

            if not in_block:
                continue

            if s[0] in "@#&":
                continue

            parts = s.split()
            if len(parts) < 3:
                continue

            try:
                x = float(parts[0])
                y = float(parts[1])
                dy = float(parts[2])
            except ValueError:
                continue

            xs.append(x)
            ys.append(y)
            dys.append(dy)

    if in_block and xs:
        datasets.append((np.array(xs), np.array(ys), np.array(dys)))

    if not datasets:
        raise RuntimeError(f"No xydy data blocks found in {filename}")

    return datasets

# ----------------------------------------------------------------------
# 4. Layout: 3 x 3
#    - (0,0) legend panel
#    - (0,1), (0,2), (1,0), (1,1), (1,2) = 5 individual plots
#    - bottom row: β-Sheets combined (cols 0–1), α-Helix combined (col 2)
# ----------------------------------------------------------------------
fig = plt.figure(figsize=(12, 10))
gs = fig.add_gridspec(
    3, 3,
    height_ratios=[1, 1, 1.1],
    hspace=0.5,
    wspace=0.3
)

# Legend axis (top-left)
ax_legend = fig.add_subplot(gs[0, 0])

# Five individual plots in the other 5 slots
ax_01 = fig.add_subplot(gs[0, 1])
ax_02 = fig.add_subplot(gs[0, 2])
ax_10 = fig.add_subplot(gs[1, 0])
ax_11 = fig.add_subplot(gs[1, 1])
ax_12 = fig.add_subplot(gs[1, 2])

axes_individual = [ax_01, ax_02, ax_10, ax_11, ax_12]

# Combined axes at bottom (SWITCHED: beta left, alpha right)
ax_super_beta  = fig.add_subplot(gs[2, 0:2])  # β-sheets (dataset 1)
ax_super_alpha = fig.add_subplot(gs[2, 2])    # α-helix (dataset 0)

# ----------------------------------------------------------------------
# 5. Plot each file
# ----------------------------------------------------------------------
for i, (ax, fname) in enumerate(zip(axes_individual, xmgr_files)):
    datasets = read_xmgr_all_xydy_blocks(fname)

    title = subplot_titles[i] if i < len(subplot_titles) else Path(fname).name
    ax.set_title(title)

    base = base_colors[i]
    lighter = lighten_color(base, factor=0.5)

    # First dataset = lighter (e.g. α), second dataset = base (e.g. β)
    per_file_colors = [lighter, base]

    for j, (x, y, dy) in enumerate(datasets):
        color = per_file_colors[j] if j < len(per_file_colors) else base

        # Top: individual subplot WITH error bars, line only
        line, caplines, barlinecols = ax.errorbar(
            x, y, yerr=dy,
            fmt="-",                 # line only, no markers
            capsize=3,
            color=color,
            ecolor="black",
            elinewidth=1.0,
        )

        for cap in caplines:
            cap.set_alpha(0.4)
        for barlinecol in barlinecols:
            barlinecol.set_alpha(0.4)

        # Bottom: superposed plots, no error bars
        if j == 0:
            # α-helix curves (now RIGHT panel)
            ax_super_alpha.plot(
                x, y,
                "-",
                linewidth=1.2,
                color=base,
                label=legend_labels[i],
            )
        elif j == 1:
            # β-sheets curves (now LEFT panel)
            ax_super_beta.plot(
                x, y,
                "-",
                linewidth=1.2,
                color=base,
                label=legend_labels[i],
            )

# ----------------------------------------------------------------------
# 6. Style axes
# ----------------------------------------------------------------------
y_ticks = np.arange(0, 51, 10)

for ax in axes_individual + [ax_super_alpha, ax_super_beta]:
    ax.tick_params(labelsize=12)
    ax.set_ylim(0, 51)
    ax.set_yticks(y_ticks)
    ax.set_xlim(300, 610)

ax_super_beta.set_title("β-Sheets [F]", fontsize=12)
ax_super_alpha.set_title("α-Helix [G]", fontsize=12)

# Legends for bottom plots (deduplicated)
for ax_super in (ax_super_beta, ax_super_alpha):
    handles, labels = ax_super.get_legend_handles_labels()
    seen = set()
    unique_handles = []
    unique_labels = []
    for h, lab in zip(handles, labels):
        if lab not in seen:
            seen.add(lab)
            unique_handles.append(h)
            unique_labels.append(lab)
    ax_super.legend(
        unique_handles,
        unique_labels,
        fontsize=7,
        labelspacing=0.2,
        handlelength=1.5,
    )

# Legend panel (top-left) – use labels from beta panel (same set as alpha)
ax_legend.axis("off")
handles_beta, labels_beta = ax_super_beta.get_legend_handles_labels()
ax_legend.legend(
    handles_beta,
    labels_beta,
    loc="center",
    fontsize=11,
    frameon=False,
)

# ----------------------------------------------------------------------
# 7. Shared axis labels
# ----------------------------------------------------------------------
fig.text(0.5, 0.04, "Temperatur [K]", ha="center", va="center", fontsize=16)
fig.text(0.04, 0.5, "Secondary Structure [%]", ha="center", va="center",
         rotation="vertical", fontsize=16)

# Layout + save
plt.tight_layout(rect=(0.08, 0.06, 1.0, 0.96))

plt.savefig("xmgr_SS_5systems_beta_left_alpha_right_legend_topleft.png", dpi=300)
plt.show()

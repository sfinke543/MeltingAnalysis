import numpy as np
import matplotlib.pyplot as plt
from pathlib import Path

# ----------------------------------------------------------------------
# 1. Your xmgr files and titles (4 original + 1 new)
# ----------------------------------------------------------------------
xmgr_files = [
    "/nfs/mathusalem/maxence/sfinke/Skripts/NormalTripHBond/Data/autoheatdata.xmgr",
    "/nfs/mathusalem/maxence/sfinke/Skripts/NormalTripHBond/Data/ff14IDPSFFdata.xmgr",
    "/nfs/mathusalem/maxence/sfinke/Skripts/NormalTripHBond/Data/Liganddata.xmgr",
    "/nfs/mathusalem/maxence/sfinke/Skripts/NormalTripHBond/Data/NoCCdata.xmgr",
    "/nfs/mathusalem/maxence/sfinke/Skripts/NormalTripHBond/Data/GateMutanddata.xmgr",
]

# Titles shown on subplots
subplot_titles = [
    "ff19SB [A]",
    "ff14IDPSFF [B]",
    "Benzothiazole [C]",
    "Without SS-Bond [D]",
    "Gate Mutand [E]",
]

# Labels used in legend (clean)
legend_labels = [
    "ff19SB",
    "ff14IDPSFF",
    "Benzothiazole",
    "Without SS-Bond",
    "Gate Mutand",
]

# ----------------------------------------------------------------------
# 2. Colors as HEX strings
# ----------------------------------------------------------------------
colors = [
    "#f44336",  # ff19SB
    "#2196f3",  # ff14IDPSFF
    "#4caf50",  # Benzothiazole
    "#ff9800",  # Without SS-Bond
    "#9c27b0",  # New System
]

# ----------------------------------------------------------------------
# 3. Helper: read the LAST @type xydy block from an .xmgr file
# ----------------------------------------------------------------------
def read_xmgr_last_xydy_block(filename):
    xs, ys, dys = [], [], []
    in_block = False

    with open(filename, "r") as f:
        for line in f:
            s = line.strip()
            if not s:
                continue

            if s.startswith("@type") and "xydy" in s:
                xs, ys, dys = [], [], []
                in_block = True
                continue

            if s.startswith("&"):
                in_block = False
                continue

            if not in_block:
                continue

            if s[0] in "@#&":
                continue

            parts = s.split()
            if len(parts) < 3:
                continue

            try:
                x = float(parts[0])
                y = float(parts[1])
                dy = float(parts[2])
            except ValueError:
                continue

            xs.append(x)
            ys.append(y)
            dys.append(dy)

    if not xs:
        raise RuntimeError(f"No xydy data block found in {filename}")

    return np.array(xs), np.array(ys), np.array(dys)

# ----------------------------------------------------------------------
# 4. Layout:
#    Rows x Cols = 3 x 3
#    - (0,0) -> legend panel
#    - (0,1), (0,2), (1,0), (1,1), (1,2) -> 5 plots
#    - row 2, all columns -> combined plot
# ----------------------------------------------------------------------
fig = plt.figure(figsize=(12, 10))
gs = fig.add_gridspec(
    3, 3,
    height_ratios=[1, 1, 1.1],
    hspace=0.5,
    wspace=0.3
)

# Legend axis (top-left)
ax_legend = fig.add_subplot(gs[0, 0])

# Five individual plots in the other 5 slots
ax_01 = fig.add_subplot(gs[0, 1])
ax_02 = fig.add_subplot(gs[0, 2])
ax_10 = fig.add_subplot(gs[1, 0])
ax_11 = fig.add_subplot(gs[1, 1])
ax_12 = fig.add_subplot(gs[1, 2])

axes_individual = [ax_01, ax_02, ax_10, ax_11, ax_12]

# Combined superposed axis at bottom
ax_super = fig.add_subplot(gs[2, :])

# ----------------------------------------------------------------------
# 5. Plot each file: individual plots with error bars, bottom = superposed lines
# ----------------------------------------------------------------------
handles_super = []

for i, (ax, fname) in enumerate(zip(axes_individual, xmgr_files)):
    x, y, dy = read_xmgr_last_xydy_block(fname)

    # Individual subplot WITH error bars; line only
    line, caplines, barlinecols = ax.errorbar(
        x, y, yerr=dy,
        fmt="-",
        capsize=3,
        color=colors[i],
        ecolor="black",
        elinewidth=1.0,
    )

    for cap in caplines:
        cap.set_alpha(0.4)
    for barcol in barlinecols:
        barcol.set_alpha(0.4)

    title = subplot_titles[i] if i < len(subplot_titles) else Path(fname).name
    ax.set_title(title)

    # Same data on the combined axis, WITHOUT error bars
    line_super, = ax_super.plot(
        x, y,
        "-",
        linewidth=1.2,
        color=colors[i],
    )
    handles_super.append(line_super)

# ----------------------------------------------------------------------
# 6. Style axes
# ----------------------------------------------------------------------
y_ticks = np.arange(0, 101, 25)

for ax in axes_individual + [ax_super]:
    ax.tick_params(labelsize=12)
    ax.set_ylim(0, 105)
    ax.set_yticks(y_ticks)
    ax.set_xlim(300, 610)

ax_super.set_title("Superposed [F]", fontsize=14)

# Legend in its own panel (top-left)
ax_legend.axis("off")
ax_legend.legend(
    handles_super,
    legend_labels,
    loc="center",
    fontsize=11,
    frameon=False,
)

# Shared axis labels
fig.text(0.5, 0.04, "Temperatur [K]", ha="center", va="center", fontsize=16)
fig.text(0.04, 0.5, "H-Bonds [%]", ha="center", va="center",
         rotation="vertical", fontsize=16)

# ----------------------------------------------------------------------
# 7. Layout + save
# ----------------------------------------------------------------------
plt.tight_layout(rect=(0.08, 0.06, 1.0, 0.96))

plt.savefig("xmgr_5graphs_legend_top_left_and_combined_bottom.png", dpi=300)
plt.show()
